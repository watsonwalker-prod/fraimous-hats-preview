{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/hats",
      "permanent": false
    },
    {
      "source": "/legal",
      "destination": "/terms",
      "permanent": false
    },
    {
      "source": "/try-a-color",
      "destination": "/hats#try-a-color",
      "permanent": false
    },
    {
      "source": "/custom-order",
      "destination": "/hats#custom-order",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "*.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "fraimous-hats-preview.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "fraimous-hats-preview--s-projects.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
